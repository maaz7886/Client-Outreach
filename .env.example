# ============================================================
#  College Outreach System — Example Environment File
#  Copy to .env and fill in every value before starting.
#  cp .env.example .env   (Linux/Mac)
#  copy .env.example .env  (Windows)
# ============================================================

# --- infrastructure ---
POSTGRES_PASSWORD=pick-a-strong-password-here

# 64-char random string. Generate with:
#   PowerShell: -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 64 | ForEach-Object {[char]$_})
#   Linux:      openssl rand -hex 32
JWT_SECRET=replace-with-64-char-random-string

# --- LLM ---
# Free tier: https://console.groq.com
LLM_PROVIDER=groq
LLM_API_KEY=gsk_your_groq_key_here

# --- public URLs ---
# Local dev:        http://localhost:8000
# With CF Tunnel:   https://api.yourdomain.com
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000

# Comma-separated origins the frontend runs on (no spaces)
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- sending ---
# Gmail: Settings > Security > 2-Step Verification > App passwords
# Or use Brevo: smtp-relay.brevo.com port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SENDER_NAME=Your Name
SENDER_EMAIL=your-email@gmail.com
SENDER_POSTAL_ADDRESS=Your Street, City, State PIN  # legally required in email footer

# --- compliance / warm-up ---
DAILY_SEND_CAP=25
HOURLY_SEND_CAP=10

# --- polite crawling ---
CRAWL_USER_AGENT=AIValyticsOutreachBot/1.0 (+contact: your-email@gmail.com)
